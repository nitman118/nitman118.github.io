          </div>
          <div class="qr-box" set:html={qr} aria-label="QR code linking to nitishsingh.com" />
        </div>
        <aside class="notes"><p>Leave this up during Q&amp;A.</p></aside>
      </section>
    </div>

    <div class="progress"><div class="bar"></div></div>

    <div class="hud" role="toolbar" aria-label="Presentation controls">
      <button id="hud-prev" title="Previous (←)" aria-label="Previous slide">←</button>
      <span class="count" id="hud-count">1 / 14</span>
      <button id="hud-next" title="Next (→)" aria-label="Next slide">→</button>
      <button id="hud-overview" title="All slides (O)">Slides</button>
      <button id="hud-notes" title="Speaker notes (N)">Notes</button>
      <button id="hud-theme" title="Light / dark (T)">Theme</button>
      <button id="hud-full" title="Fullscreen (F)">Fullscreen</button>
      <button id="hud-help" title="Shortcuts (?)" aria-label="Keyboard shortcuts">?</button>
    </div>

    <div class="notes-panel" id="notes" hidden></div>

    <div class="overlay" id="overview" hidden>
      <h2>All slides</h2>
      <div class="ov-grid"></div>
    </div>

    <div class="overlay" id="help" hidden>
      <div class="help-box">
        <h2>Keyboard shortcuts</h2>
        <table>
          <tr><td><kbd>→</kbd><kbd>Space</kbd><kbd>PgDn</kbd></td><td>Next slide (clickers work too)</td></tr>
          <tr><td><kbd>←</kbd><kbd>PgUp</kbd></td><td>Previous slide</td></tr>
          <tr><td><kbd>Home</kbd><kbd>End</kbd></td><td>First / last slide</td></tr>
          <tr><td><kbd>F</kbd></td><td>Fullscreen</td></tr>
          <tr><td><kbd>O</kbd></td><td>All slides</td></tr>
          <tr><td><kbd>N</kbd></td><td>Speaker notes</td></tr>
          <tr><td><kbd>T</kbd></td><td>Light / dark theme</td></tr>
          <tr><td><kbd>Esc</kbd></td><td>Leave a text field / close overlays</td></tr>
        </table>
      </div>
    </div>

    <div class="toast" id="toast" role="status" aria-live="polite"></div>

    <script>
      import '../../slides/shared/deck.js';
      import '../../slides/data-platform/dip.js';
    </script>
  </body>
</html>
